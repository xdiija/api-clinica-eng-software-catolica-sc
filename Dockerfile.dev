FROM mcr.microsoft.com/dotnet/sdk:10.0

ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    HOME=/home/app \
    NUGET_PACKAGES=/home/app/.nuget/packages \
    ASPNETCORE_URLS=http://+:8080 \
    ASPNETCORE_ENVIRONMENT=Development \
    PATH="/usr/local/dotnet-tools:${PATH}"

RUN dotnet tool install dotnet-ef --version 10.0.12 --tool-path /usr/local/dotnet-tools \
    && mkdir -p /home/app/.nuget/packages \
    && chmod -R 777 /home/app

RUN mkdir -p /src/obj /src/bin && chmod 777 /src/obj /src/bin

WORKDIR /src
EXPOSE 8080

CMD ["dotnet", "watch", "run", "--project", "ApiClinica.csproj", \
     "--non-interactive", "--no-launch-profile"]
